+bool prts_sim_supports_mul_mat(ggml_metal_device_t dev, const struct ggml_tensor * op) {
+    if (!dev->sim_bf16 || op->op != GGML_OP_MUL_MAT) {
+        return false;
+    }
+    const struct ggml_tensor * a = op->src[0], * b = op->src[1];
+    if (a->type != GGML_TYPE_BF16 || b->type != GGML_TYPE_F32 || op->type != GGML_TYPE_F32 ||
+        !ggml_is_matrix(a) || !ggml_is_matrix(b) || !ggml_is_matrix(op) ||
+        !ggml_is_contiguous(a) || !ggml_is_contiguous(b) || !ggml_is_contiguous(op) ||
+        a->view_offs % 2 || b->view_offs % 4 || op->view_offs % 4) {
+        return false;
+    }
+    const int64_t k = a->ne[0], m = a->ne[1], n = b->ne[1];
+    return k > 0 && m > 0 && n > 0 && b->ne[0] == k && op->ne[0] == m && op->ne[1] == n &&
+           k <= INT32_MAX / m && k <= INT32_MAX / n && m <= INT32_MAX / n;
+}
+
+void prts_sim_encode_mul_mat(ggml_metal_device_t dev, ggml_metal_encoder_t enc, const struct ggml_tensor * op,
+                             struct ggml_metal_buffer_id weights, struct ggml_metal_buffer_id input,
+                             struct ggml_metal_buffer_id output) {
+    // Bind aligned addresses, carrying the remaining element offsets of tensor views in the arguments.
+    const uint32_t k = op->src[0]->ne[0], m = op->ne[0], n = op->ne[1];
+    uint32_t dims[] = { k, m, n, (uint32_t)(weights.offs % 16) / 2,
+                         (uint32_t)(input.offs % 16) / 4, (uint32_t)(output.offs % 16) / 4 };
+    weights.offs -= weights.offs % 16;
+    input.offs -= input.offs % 16;
+    output.offs -= output.offs % 16;
+    [enc->obj setComputePipelineState:dev->sim_bf16];
+    ggml_metal_encoder_set_buffer(enc, weights, 0);
+    ggml_metal_encoder_set_buffer(enc, input, 1);
+    ggml_metal_encoder_set_buffer(enc, output, 2);
+    ggml_metal_encoder_set_bytes(enc, dims, sizeof(dims), 3);
+    ggml_metal_encoder_dispatch_threadgroups(enc, (m + 31) / 32, (n + 31) / 32, 1, 8, 8, 1);
+}
