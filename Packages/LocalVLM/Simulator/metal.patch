+static id<MTLComputePipelineState> prts_sim_new_bf16_pipeline(id<MTLDevice> device) {
+    // Compiled independently: failure leaves ggml's original CPU fallback available.
+    static const unsigned char source[] = {
+#include "prts-simulator-msl.inc"
+    };
+    NSString * text = [[NSString alloc] initWithBytes:source length:sizeof(source) encoding:NSUTF8StringEncoding];
+    MTLCompileOptions * options = [MTLCompileOptions new];
+    options.fastMathEnabled = NO;
+    id<MTLLibrary> library = [device newLibraryWithSource:text options:options error:NULL];
+    [options release];
+    [text release];
+    id<MTLFunction> fn = [library newFunctionWithName:@"prts_sim_bf16"];
+    id<MTLComputePipelineState> pipeline = fn ? [device newComputePipelineStateWithFunction:fn error:NULL] : nil;
+    [fn release];
+    [library release];
+    if (pipeline.maxTotalThreadsPerThreadgroup < 64 ||
+        pipeline.staticThreadgroupMemoryLength > device.maxThreadgroupMemoryLength) {
+        [pipeline release];
+        return nil;
+    }
+    return pipeline;
+}
